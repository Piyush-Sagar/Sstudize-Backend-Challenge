{
  "info": {
    "name": "Sstudize Auth API",
    "description": "Complete authentication backend API collection for Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "sstudize-auth-api"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "challengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "otpCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Healthy status', () => pm.expect(pm.response.json().status).to.equal('healthy'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"phone\": \"+14155552671\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has user data', () => pm.expect(pm.response.json().data).to.have.property('id'));",
                  "pm.test('Email matches', () => pm.expect(pm.response.json().data.email).to.equal('user@example.com'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (no 2FA)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('No 2FA required', () => pm.expect(pm.response.json().requires2FA).to.be.false);",
                  "pm.test('Has tokens', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('accessToken');",
                  "  pm.expect(data).to.have.property('refreshToken');",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (with 2FA enabled)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user2fa@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('2FA required', () => pm.expect(pm.response.json().requires2FA).to.be.true);",
                  "pm.test('Has challengeId', () => {",
                  "  const challengeId = pm.response.json().challengeId;",
                  "  pm.expect(challengeId).to.be.a('string');",
                  "  pm.collectionVariables.set('challengeId', challengeId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/2fa/verify",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/2fa/verify",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{otpCode}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has tokens after verify', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('accessToken');",
                  "  pm.expect(data).to.have.property('refreshToken');",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/2fa/enable",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/2fa/enable",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has challengeId', () => {",
                  "  const challengeId = pm.response.json().challengeId;",
                  "  pm.expect(challengeId).to.be.a('string');",
                  "  pm.collectionVariables.set('challengeId', challengeId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/token/refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/token/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has new tokens', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('accessToken');",
                  "  pm.expect(data).to.have.property('refreshToken');",
                  "  pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "});",
                  "pm.test('Tokens rotated', () => {",
                  "  pm.expect(pm.response.json().data.accessToken).to.not.equal(pm.collectionVariables.get('accessToken_old'));",
                  "  pm.expect(pm.response.json().data.refreshToken).to.not.equal(pm.collectionVariables.get('refreshToken_old'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success message', () => pm.expect(pm.response.json().message).to.equal('Logged out successfully'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Password Reset",
      "item": [
        {
          "name": "POST /api/auth/forgot-password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Generic message', () => pm.expect(pm.response.json().message).to.include('If an account exists'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/reset-password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/reset-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success message', () => pm.expect(pm.response.json().message).to.equal('Password has been reset successfully'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "GET /api/profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/profile",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has profile data', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.have.property('id');",
                  "  pm.expect(data).to.have.property('email');",
                  "  pm.expect(data).to.have.property('phone');",
                  "  pm.expect(data).to.have.property('is2faEnabled');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}